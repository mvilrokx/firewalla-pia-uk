#!/bin/bash
# Test stand-in for curl. Records every argument and, with `-K -`, every config
# line it reads on stdin. Answers the PIA and BBC calls from fixtures, and passes
# file:// URLs to the real curl. SHIM_CURL_FAIL_URL=<part of a URL> makes that
# call fail like a timeout. With -w '\n%{http_code}' the answer ends with the
# HTTP status: SHIM_HTTP_CODE, else 200.
url="" config_on_stdin=0 prev="" write_out=""
for arg in "$@"; do
  case $arg in http*|file:*) url=$arg ;; esac
  if [[ $prev == -K && $arg == - ]]; then config_on_stdin=1; fi
  if [[ $prev == -w ]]; then write_out=$arg; fi
  prev=$arg
done
if [[ -n ${SHIM_LOG:-} ]]; then
  for arg in "$@"; do printf 'curl-arg %s\n' "$arg"; done >> "$SHIM_LOG"
  if (( config_on_stdin )); then
    while IFS= read -r line; do printf 'curl-config %s\n' "$line"; done >> "$SHIM_LOG"
  fi
fi
if [[ -n ${SHIM_CURL_FAIL_URL:-} && $url == *"$SHIM_CURL_FAIL_URL"* ]]; then
  echo "curl: (28) Operation timed out (test)" >&2
  exit 28
fi
default_token='{"token":"TKN"}'
case $url in
  file:*) exec /usr/bin/curl "$@" ;;
  */token*) printf '%s' "${SHIM_TOKEN_BODY-$default_token}" ;;
  */addKey*) cat "${SHIM_ADDKEY_FILE:-$FIXTURES/addkey_ok.json}" ;;
  *mediaselector*) cat "${SHIM_BBC_FILE:-$FIXTURES/mediaselector_ok.json}" ;;
esac
if [[ $write_out == *http_code* ]]; then printf '\n%s' "${SHIM_HTTP_CODE:-200}"; fi
exit 0
