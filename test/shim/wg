#!/bin/bash
# Test stand-in for wg. Its answers come from SHIM_* environment variables;
# a `wg set` makes a handshake at that moment (its time in $SHIM_STATE/fresh).
if [[ -n ${SHIM_LOG:-} ]]; then echo "wg $*" >> "$SHIM_LOG"; fi
if [[ ${SHIM_WG_BROKEN:-0} == 1 ]]; then echo "wg: broken (test)" >&2; exit 1; fi
case ${1:-} in
  show)
    if [[ ${SHIM_IFACE_MISSING:-0} == 1 ]]; then
      echo "Unable to access interface: No such device" >&2
      exit 1
    fi
    case ${3:-} in
      latest-handshakes)
        age=${SHIM_HANDSHAKE_AGE:-10}
        # never-then-fresh: a client that Firewalla has just started.
        if [[ $age == never-then-fresh ]]; then
          if [[ -f $SHIM_STATE/seen ]]; then age=5; else touch "$SHIM_STATE/seen"; age=never; fi
        fi
        if [[ $age == never ]]; then ts=0; else ts=$(( $(date +%s) - age )); fi
        if [[ -n ${SHIM_STATE:-} && -f $SHIM_STATE/fresh ]]; then ts=$(cat "$SHIM_STATE/fresh"); fi
        printf 'SERVERPUB\t%s\n' "$ts" ;;
      public-key) echo "${SHIM_CLIENT_PUB:-CLIENTPUB=}" ;;
      peers) echo "SERVERPUB" ;;
      *) echo "interface: $2" ;;
    esac ;;
  set)
    if [[ -n ${SHIM_STATE:-} && ${SHIM_NO_FRESH:-0} != 1 ]]; then date +%s > "$SHIM_STATE/fresh"; fi
    exit "${SHIM_WG_SET_RC:-0}" ;;
  genkey) echo "PRIVTEST=" ;;
  pubkey) printf 'PUBOF:%s\n' "$(cat)" ;;
esac
